rules_version = '2';

// Ҳар корбар танҳо ҳуҷҷатҳои худашро мехонад ва менависад: users/{uid}/sync/{meta | chunk_N}
service cloud.firestore {
  match /databases/{database}/documents {
    // Пайвастани Telegram-бот: барнома рамзи яккарата месозад, бот онро бо ҳисоби хидматӣ мехонад ва нест мекунад.
    match /botLinks/{code} {
      allow create: if request.auth != null
        && code.matches('[A-Z2-9]{10}')
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Ҳолати пайвастшавии бот (сабт мешавад аз тарафи бот): корбар мехонад ва ҷудо мекунад.
    match /users/{uid}/bot/{docId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
    }

    // Танзимоти огоҳиномаҳои Telegram: барнома ва бот ҳарду менависанд. Ҳамаи калидҳо ҳатмӣ ва boolean, соат аз рӯйхат.
    match /users/{uid}/bot/prefs {
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['hour', 'pay', 'overdue', 'weekly', 'monthly', 'noentry', 'dreams', 'debtpaid', 'autosave', 'goals', 'loans', 'bigexp', 'catover', 'evening', 'tips', 'lang'])
        && (!('lang' in request.resource.data) || request.resource.data.lang in ['tg', 'ru', 'en'])
        && request.resource.data.hour in [7, 9, 12, 18, 21]
        && request.resource.data.pay is bool && request.resource.data.overdue is bool
        && request.resource.data.weekly is bool && request.resource.data.monthly is bool
        && request.resource.data.noentry is bool && request.resource.data.dreams is bool
        && request.resource.data.debtpaid is bool && request.resource.data.autosave is bool
        && request.resource.data.goals is bool && request.resource.data.loans is bool
        && request.resource.data.bigexp is bool && request.resource.data.catover is bool
        && request.resource.data.evening is bool && request.resource.data.tips is bool;
    }

    match /users/{uid}/sync/{docId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null && request.auth.uid == uid && (
        (
          docId == 'meta'
          && request.resource.data.keys().hasOnly(['rev', 'chunks', 'size', 'updatedAt', 'device'])
          && request.resource.data.rev is int
          && request.resource.data.rev == (resource == null ? 1 : resource.data.rev + 1)
          && request.resource.data.chunks is int
          && request.resource.data.chunks >= 1 && request.resource.data.chunks <= 20
        ) || (
          docId.matches('chunk_[0-9]+')
          && request.resource.data.keys().hasOnly(['i', 'part'])
          && request.resource.data.part is string
          && request.resource.data.part.size() <= 300000
        )
      );
    }
  }
}
